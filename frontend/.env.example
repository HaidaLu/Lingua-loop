# By default the frontend forwards /api to http://localhost:8000 via the vite proxy — no config needed.
# If the backend is not on localhost:8000:
# VITE_API_TARGET=http://192.168.1.10:8000

# To hit the backend directly (bypassing the proxy; requires backend CORS to allow the origin):
# VITE_API_BASE=http://localhost:8000
