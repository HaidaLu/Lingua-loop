# Copy to .env and adjust as needed. Everything has a default; with none set it runs on the mock generator.

# LLM provider: openai | claude | mock
LLM_PROVIDER=openai

# --- openai-compatible (DashScope/Qwen, OpenAI, any compatible endpoint) ---
# DashScope (Alibaba Cloud Qwen) example:
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-max
# For the official OpenAI API instead:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# --- claude (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- auth (single-user login gate) ---
# In production use a random value: python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=dev-insecure-secret-change-me-in-production-32b+
AUTH_TOKEN_TTL_HOURS=720

# --- infra ---
DATABASE_URL=sqlite:///./language_learning.db
MEDIA_DIR=./media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
